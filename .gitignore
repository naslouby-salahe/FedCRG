# Runtime data and generated outputs
data/
outputs/*
!outputs/.gitignore
!outputs/README.md
!outputs/logs/
!outputs/logs/.gitkeep
!outputs/monitoring/
!outputs/monitoring/.gitkeep
!outputs/runs/
!outputs/runs/.gitkeep
!outputs/cache/
!outputs/cache/**/
!outputs/cache/**/.gitkeep
!outputs/reports/
!outputs/reports/**/
!outputs/reports/**/.gitkeep
